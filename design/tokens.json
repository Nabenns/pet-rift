    "textMid": "#D6D0F5",
    "textLow": "#B0A9DD",
    "positive": "#7BF5A6",
    "negative": "#FF8FA8",
    "gold": "#FFD24A",
    "backdrop": "#0B0718"
  },
  "roles": {
