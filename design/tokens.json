    "neutral": { "top": "#9C94DB", "bottom": "#6E66B3", "lip": "#40397A", "text": "#FFFFFF" },
    "premium": { "top": "#FFE27A", "bottom": "#FFB224", "lip": "#B06B00", "text": "#FFFFFF" },
    "danger":  { "top": "#FF7A98", "bottom": "#EE3D66", "lip": "#9A1838", "text": "#FFFFFF" },
    "info":    { "top": "#7CC8FF", "bottom": "#3D93F0", "lip": "#1D58A8", "text": "#FFFFFF" },
    "done":    { "top": "#ECE9FA", "bottom": "#C4BEE0", "lip": "#827BA8", "text": "#2D2852" },
    "locked":  { "top": "#4F4980", "bottom": "#3A3466", "lip": "#221D42", "text": "#B3ACDB" }
  },
  "themes": {
    "shop":     { "top": "#FFB54D", "bottom": "#FF7B22", "lip": "#B9480A" },
    "codes":    { "top": "#5DEBDB", "bottom": "#18B5C6", "lip": "#0C6F80" },
    "rebirth":  { "top": "#CF9BFF", "bottom": "#9257F2", "lip": "#5A2AAE" },
    "settings": { "top": "#86AEFF", "bottom": "#4F7BEA", "lip": "#2B4CA3" },
    "daily":    { "top": "#FF9ACD", "bottom": "#F25AA2", "lip": "#A82568" },
    "neutral":  { "top": "#9C94DB", "bottom": "#6E66B3", "lip": "#40397A" }
  },
  "type": {
    "display": { "font": "Fredoka One", "size": 36, "stroke": 3.5 },
    "title":   { "font": "Fredoka One", "size": 26, "stroke": 2.5 },
    "button":  { "font": "Fredoka One", "size": 24, "stroke": 2.5 },
    "number":  { "font": "Fredoka One", "size": 30, "stroke": 3 },
    "small":   { "font": "Fredoka One", "size": 18, "stroke": 2 },
    "body":    { "font": "Builder Sans Bold", "size": 18, "stroke": 0 },
    "caption": { "font": "Builder Sans SemiBold", "size": 15, "stroke": 0 }
  },
  "fonts": {
    "display": "rbxasset://fonts/families/FredokaOne.json",
    "body": "rbxasset://fonts/families/BuilderSans.json"
  },
  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 },
  "radii": { "panel": 22, "header": 14, "card": 14, "button": 12, "input": 10, "pill": "half-height" },
  "strokes": { "panel": 4, "card": 3, "button": 3, "input": 2.5, "focus": 3, "divider": 2 },
  "sizes": {
    "buttonHeight": 56, "buttonLip": 6, "buttonLipSmall": 4,
    "touchBoxMin": 52, "close": 52, "hud": 64,
    "window": [760, 520], "headerHeight": 72, "headerInset": 8, "bodyInset": 16, "bodyTop": 92,
    "toggle": [84, 40], "toggleKnob": 32, "progressHeight": 30, "textField": 56,
    "cardShop": [220, 236], "cardDaily": [156, 196], "cardDay7": [324, 196], "cardTier": ["half", 176]
  },
  "responsive": {
    "deviceBaseScale": {
      "phone": 1.0,
      "desktopTablet": "clamp(safeHeight / 1000, 0.85, 1.4)",
      "console": 1.35
    },
    "touchFloor": 0.846,
    "playerScaleRange": [0.8, 1.3],
    "testViewports": [[1920,1080],[1366,768],[1024,768],[844,390],[667,375]]
  },
  "motion": {
    "open":      { "prop": "UIScale.Scale", "from": 0.86, "to": 1, "time": 0.22, "ease": "Back Out" },
    "close":     { "prop": "UIScale.Scale", "to": 0.90, "time": 0.12, "ease": "Quad In" },
    "dimmerIn":  { "prop": "BackgroundTransparency", "to": 0.45, "time": 0.18, "ease": "Quad Out" },
    "hover":     { "prop": "UIScale.Scale", "to": 1.04, "time": 0.10, "ease": "Quad Out" },
    "press":     { "prop": "Position+Scale", "sink": "lip-2", "to": 0.96, "time": 0.05, "ease": "Quad Out" },
    "release":   { "time": 0.16, "ease": "Back Out" },
    "toggle":    { "time": 0.16, "ease": "Quad Out" },
    "progress":  { "time": 0.35, "ease": "Quad Out" },
    "sunburst":  { "spin": 360, "time": 16, "ease": "Linear" }
  },
  "rules": [
    "Satu tombol hijau (go) per layar, dengan kata kerja di caption.",
    "Tap target >= 52 unit, jarak antar target >= 8.",
    "Teks minimal 15 design unit.",
    "Nested radius: radius dalam = radius luar - gap.",
    "Jangan hapus ink stroke dari caption di slab terang.",
    "State locked/claimed jangan dibedakan cuma dari warna.",
    "Reduced Motion: tidak ada scale/spin/glow/shake."
  ]
}